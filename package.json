{
  "name": "aicoding-template-video-rve",
  "version": "1.0.0-rve.1",
  "description": "用 RVE 视觉语言的 HyperFrames 模板把中文内容做成 9:16/16:9 短视频 —— 中文 TTS + 统一 token 的模板流水线",
  "main": "src/cli.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pipeline": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts"
  },
  "keywords": [
    "video",
    "tts",
    "news",
    "chinese",
    "mandarin",
    "tiktok",
    "shorts",
    "hyperframes",
    "claude-code",
    "omnivoice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
